{
  // Luau LSP gets its Roblox API knowledge from a sourcemap generated by Rojo.
  // Regenerate after adding services or instances:  rojo sourcemap default.project.json -o sourcemap.json
  "luau-lsp.sourcemap.enabled": true,
  "luau-lsp.sourcemap.autogenerate": true,
  "luau-lsp.sourcemap.rojoProjectFile": "default.project.json",
  "luau-lsp.types.roblox": true,
  "luau-lsp.require.mode": "relativeToFile",

  "files.associations": { "*.lua": "luau", "*.luau": "luau" },
  "files.eol": "\n",
  "[luau]": { "editor.defaultFormatter": "JohnnyMorganz.stylua" },
  "[lua]": { "editor.defaultFormatter": "JohnnyMorganz.stylua" },
  "editor.formatOnSave": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": false,
  "editor.guides.indentation": true
}
